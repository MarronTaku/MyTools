{
  "name": "DS-Lab",
  "dockerComposeFile": "compose.yml",
  "service": "jupyter",
  "workspaceFolder": "/home/jovyan/work",
  "remoteUser": "jovyan",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "Google.gemini",
        "mhutchie.git-graph",
        "GitHub.copilot"
      ],
      "settings": {
        "editor.tabSize": 2,
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "editor.inlineSuggest.enabled": true,
        "google.gemini.enableInlineSuggestions": false
      }
    }
  }
}